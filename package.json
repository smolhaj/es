{
  "name": "es",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run schema:manifest && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --d1 DB=a6b128d4-5bb1-4b1a-944a-eb82fdf940f0 --kv KV --port 8788",
    "cf:deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:create": "wrangler d1 migrations create DB",
    "schema:manifest": "node scripts/build-schema-manifest.mjs",
    "health": "node scripts/check-health.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10",
    "wrangler": "^3.89.0"
  }
}
